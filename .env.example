# Plantilla de credenciales de IBM Quantum.
# Copiar a .env (en la raíz del repositorio) y rellenar. El .env real NO se versiona.
# Lo leen TSM/quantum/qaoa_tsm_ibm.py y NRP/quantum/qaoa_nrp_ibm.py.

# API key de IBM Quantum Platform (obligatoria).
IBM_QUANTUM_TOKEN=tu_api_key_aqui

# Canal de Qiskit Runtime: ibm_cloud (IBM Quantum Platform actual) o ibm_quantum_platform.
IBM_QUANTUM_CHANNEL=ibm_cloud

# CRN de la instancia (opcional; si se deja vacío, Qiskit elige una instancia disponible).
IBM_QUANTUM_INSTANCE=

# Procesador por defecto (opcional).
IBM_QUANTUM_BACKEND=ibm_fez
